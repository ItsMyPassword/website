---
import { useT } from "~/i18n/index.js";
import type { Locale } from "~/i18n/translations.js";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);

/* The pull quote is split into words at render time so each word can
   light up on its own slice of the scroll timeline. The copy itself is
   untouched. */
const quoteWords = t("pullquote_text").split(" ");

const claims = [
  { label: t("promise_no_vault"), body: t("promise_no_vault_body") },
  { label: t("promise_no_cloud"), body: t("promise_no_cloud_body") },
  { label: t("promise_no_telemetry"), body: t("promise_no_telemetry_body") },
  { label: t("promise_oss"), body: t("promise_oss_body") },
];

/**
 * The derivation snippet. Plain text so it survives Astro template parsing
 * cleanly; colouring is done by a tiny client-side pass on character
 * classes (keywords, strings, numbers, comments).
 */
const snippet = `export async function derive(master, site, email, counter) {
  const salt = utf8(\`\${site}|\${email}|\${counter}\`);
  const raw  = await argon2id({ password: master, salt, iterations: 3, memory: 65536, parallelism: 1, hashLength: 32 });
  return shape(raw, profile);  // length, char classes, suffix rules
}`;
---

<section class="relative isolate z-[5] bg-(--color-bg-0) px-6 py-28 sm:py-40">
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-20 sm:gap-28">
    <div class="flex flex-col gap-14">
      <header data-reveal class="flex max-w-3xl flex-col gap-4">
        <h2 class="h2-display m-0 text-(--color-ink-0)">
          {t("promise_title")}
        </h2>
        <p class="m-0 text-pretty text-(--color-ink-2) sm:text-lg">{t("promise_body")}</p>
      </header>

      <ul
        data-reveal-stagger
        class="m-0 flex list-none flex-col border-y border-(--color-ink-5) p-0"
      >
        {
          claims.map((claim) => (
            <li class="group grid grid-cols-1 items-baseline gap-2 border-b border-(--color-ink-5) py-7 transition-colors duration-300 last:border-b-0 sm:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] sm:gap-10 sm:py-9">
              <h3 class="m-0 text-2xl font-semibold tracking-[-0.02em] text-(--color-ink-0) transition-transform duration-300 [transition-timing-function:var(--ease-out-quint)] sm:text-3xl sm:group-hover:translate-x-2">
                {claim.label}
              </h3>
              <p class="m-0 max-w-xl text-pretty leading-relaxed text-(--color-ink-2) transition-colors duration-300 group-hover:text-(--color-ink-1)">
                {claim.body}
              </p>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="m-0 flex flex-col items-center gap-6 py-4 text-center sm:py-12">
      <blockquote
        class="pq m-0 max-w-4xl text-balance font-semibold tracking-[-0.025em] text-(--color-ink-0)"
        style="font-size: clamp(32px, 5vw, 68px); line-height: 1.1;"
      >
        <span aria-hidden="true" class="text-(--color-ink-4)">“</span>{
          quoteWords.map((word, i) => (
            <span
              class="pq-word"
              style={`animation-range: cover ${6 + i * 3}% cover ${26 + i * 3}%;`}
            >
              {word}
              {i < quoteWords.length - 1 ? " " : ""}
            </span>
          ))
        }<span aria-hidden="true" class="text-(--color-ink-4)">”</span>
      </blockquote>
      <figcaption class="mono-tag">{t("pullquote_attr")}</figcaption>
    </figure>

    <div data-reveal class="mx-auto flex w-full max-w-3xl flex-col gap-4">
      <div
        data-spotlight
        class="overflow-hidden rounded-2xl border border-(--color-ink-5) bg-(--color-bg-1)"
        style="box-shadow: inset 0 1px 0 var(--surface-highlight), var(--surface-shadow);"
      >
        <div class="flex items-center justify-between border-b border-(--color-ink-5) px-5 py-3">
          <span class="mono-tag">derive.ts</span>
          <span class="mono-tag opacity-70">argon2id</span>
        </div>
        <pre
          id="promise-code"
          class="m-0 overflow-x-auto p-5 font-mono text-[13px] leading-relaxed text-(--color-ink-1)"><code>{snippet}</code></pre>
      </div>
      <div class="flex items-center justify-between gap-4">
        <span class="text-sm text-(--color-ink-3)">{t("promise_code_caption")}</span>
        <a
          href="https://github.com/Keyfount/extension"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-(--color-ink-1) underline-offset-4 transition-colors hover:text-(--color-ink-0) hover:underline"
        >
          {t("promise_code_read")} →
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Scroll-lit pull quote: each word owns a slice of the blockquote's
     view timeline (inline animation-range per word), so the sentence
     lights up as the reader scrolls through it. Browsers without
     scroll-driven animations (and reduced motion) read it fully lit. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pq {
        view-timeline: --pq block;
        animation: pq-zoom linear both;
        animation-timeline: --pq;
        animation-range: cover 0% cover 55%;
        will-change: transform;
      }
      .pq-word {
        opacity: 0.14;
        animation: pq-in linear both;
        animation-timeline: --pq;
      }
      @keyframes pq-in {
        to {
          opacity: 1;
        }
      }
      @keyframes pq-zoom {
        from {
          transform: scale(0.9);
        }
        to {
          transform: scale(1);
        }
      }
    }
  }
</style>

<script>
  /**
   * Light syntax colouring for the derive.ts snippet — keywords, strings,
   * numbers, comments. Kept inline to avoid pulling in a 400KB highlighter
   * for four lines of code.
   */
  const KEYWORDS = new Set([
    "export",
    "async",
    "function",
    "const",
    "return",
    "await",
    "let",
    "if",
    "else",
  ]);
  const KEYWORD_CLASS = "text-(--color-ink-3)";
  const STRING_CLASS = "text-[oklch(0.55_0.10_30)]";
  const NUMBER_CLASS = "text-[oklch(0.55_0.12_240)]";
  const COMMENT_CLASS = "text-(--color-ink-3) italic";

  function escapeHtml(s: string) {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function highlight(src: string) {
    const lines = src.split("\n");
    return lines
      .map((line) => {
        // Comments win the whole tail.
        const commentIdx = line.indexOf("//");
        let head = line;
        let tail = "";
        if (commentIdx >= 0) {
          head = line.slice(0, commentIdx);
          tail = `<span class="${COMMENT_CLASS}">${escapeHtml(line.slice(commentIdx))}</span>`;
        }
        // Tokenise the head by words and punctuation.
        const tokens = head.split(/(\s+|[(){};,]|`[^`]*`|\b\d+\b)/g);
        const rendered = tokens
          .map((tok) => {
            if (tok === "") return "";
            if (/^\s+$/.test(tok)) return tok;
            if (/^[(){};,]$/.test(tok)) return escapeHtml(tok);
            if (/^`[^`]*`$/.test(tok))
              return `<span class="${STRING_CLASS}">${escapeHtml(tok)}</span>`;
            if (/^\d+$/.test(tok)) return `<span class="${NUMBER_CLASS}">${tok}</span>`;
            if (KEYWORDS.has(tok)) return `<span class="${KEYWORD_CLASS}">${tok}</span>`;
            return escapeHtml(tok);
          })
          .join("");
        return rendered + tail;
      })
      .join("\n");
  }

  const pre = document.getElementById("promise-code");
  const code = pre?.querySelector("code");
  if (code !== null && code !== undefined) {
    code.innerHTML = highlight(code.textContent ?? "");
  }
</script>
