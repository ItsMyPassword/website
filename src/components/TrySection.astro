---
import { useT } from "~/i18n/index.js";
import type { Locale } from "~/i18n/translations.js";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);

/**
 * Localised strings shipped to the client-side generator as a single
 * data attribute. Keeping the contract here means the script itself
 * stays string-agnostic.
 */
const generatorStrings = {
  tryMaster: t("try_master"),
  trySite: t("try_site"),
  trySitePlaceholder: t("try_site_placeholder"),
  tryEmail: t("try_email"),
  tryEmailPlaceholder: t("try_email_placeholder"),
  tryMode: t("try_mode"),
  tryModeRandom: t("try_mode_random"),
  tryModeMemorable: t("try_mode_memorable"),
  tryLength: t("try_length"),
  tryWords: t("try_words"),
  trySeparator: t("try_separator"),
  tryCounter: t("try_counter"),
  tryClasses: t("try_classes"),
  tryClassLower: t("try_class_lower"),
  tryClassUpper: t("try_class_upper"),
  tryClassDigits: t("try_class_digits"),
  tryClassSymbols: t("try_class_symbols"),
  tryCapitalise: t("try_capitalise"),
  trySuffix: t("try_suffix"),
  tryGenerate: t("try_generate"),
  tryGenerating: t("try_generating"),
  tryIdle: t("try_idle"),
  trySettings: t("try_settings"),
  tryResult: t("try_result"),
  tryCopy: t("try_copy"),
  tryCopied: t("try_copied"),
  tryReveal: t("try_reveal"),
  tryHide: t("try_hide"),
  tryDisclaimer: t("try_disclaimer"),
  tryMinMaster: t("try_min_master"),
};
---

<section
  id="try"
  class="try-spot relative isolate z-[5] scroll-mt-16 overflow-hidden border-y border-(--color-ink-5) bg-(--color-bg-1) px-6 py-28 sm:py-36"
>
  <div
    aria-hidden="true"
    class="try-glow pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500"
  >
  </div>
  <div class="relative mx-auto flex w-full max-w-5xl flex-col gap-10">
    <header data-reveal class="flex flex-col gap-4 text-center">
      <h2
        class="headline-gradient m-0 font-extrabold tracking-[-0.025em] leading-[1.05]"
        style="font-size: clamp(44px, 6.2vw, 80px);"
      >
        {t("try_title")}
      </h2>
      <p class="m-0 text-pretty text-(--color-ink-2) sm:text-lg">{t("try_body")}</p>
    </header>

    <div id="generator-root" data-strings={JSON.stringify(generatorStrings)}></div>
  </div>
</section>

<style>
  .try-glow {
    background: radial-gradient(
      520px circle at var(--mx, 50%) var(--my, 40%),
      var(--color-accent-soft),
      transparent 70%
    );
  }
  .try-spot:hover .try-glow {
    opacity: 1;
  }
</style>

<script>
  import { mountGenerator } from "~/scripts/generator.ts";

  const root = document.getElementById("generator-root");
  if (root !== null) {
    const strings = JSON.parse(root.dataset.strings ?? "{}");
    mountGenerator({ root, strings });
  }

  /* Accent spotlight that follows the cursor over the section. Reads the
     shared mouse position published by GlobalChrome; only runs on hover-
     capable devices and only while the section is on screen. */
  (() => {
    const section = document.getElementById("try");
    if (section === null) return;
    if (!window.matchMedia("(hover: hover)").matches) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let onscreen = false;
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((entries) => {
        onscreen = entries[0]!.isIntersecting;
      }).observe(section);
    } else {
      onscreen = true;
    }

    function loop() {
      const mouse = window.__mouse;
      if (onscreen && mouse?.active) {
        const rect = section!.getBoundingClientRect();
        section!.style.setProperty("--mx", `${mouse.x - rect.left}px`);
        section!.style.setProperty("--my", `${mouse.y - rect.top}px`);
      }
      requestAnimationFrame(loop);
    }
    loop();
  })();
</script>
