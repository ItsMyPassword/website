---
import "~/styles/global.css";
import { useT, pathHelper } from "~/i18n/index.js";
import { LOCALES, type Locale } from "~/i18n/translations.js";
import GlobalChrome from "~/components/GlobalChrome.astro";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Path without the locale prefix (e.g. "/", "/try"). */
  path: string;
}

const { locale, title, description, path } = Astro.props;
const t = useT(locale);

const fullTitle = title ?? t("meta_title");
const fullDescription = description ?? t("meta_description");

const canonical = new URL(`${pathHelper(locale).to(path)}`, Astro.site).toString();
const ogImage = new URL("og.png", Astro.site).toString();

const alternates = LOCALES.map((loc) => ({
  locale: loc,
  href: new URL(`${pathHelper(loc).to(path)}`, Astro.site).toString(),
}));

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Keyfount",
  applicationCategory: "BrowserApplication",
  operatingSystem: "Chrome",
  description: fullDescription,
  url: canonical,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: {
    "@type": "Organization",
    name: "Keyfount",
    url: "https://github.com/Keyfount",
  },
  license: "https://opensource.org/licenses/MIT",
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a10" media="(prefers-color-scheme: dark)" />

    {/* Boot script — runs before paint to set the right theme without a flash. */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");
          const dark =
            saved !== null
              ? saved === "dark"
              : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        } catch {
          /* localStorage blocked — fall through to the default light theme */
        }
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={fullDescription} />
    <link rel="canonical" href={canonical} />

    {alternates.map((alt) => <link rel="alternate" hreflang={alt.locale} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />

    <link rel="icon" type="image/svg+xml" href={new URL("logo.svg", Astro.site).pathname} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={fullDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Keyfount" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={fullDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <div class="scroll-progress" aria-hidden="true"></div>
    <GlobalChrome locale={locale} path={path} />
    <slot />

    <script>
      /**
       * Scroll-reveal. Adds `.is-revealed` to any element tagged with
       * `data-reveal` or `data-reveal-stagger` once it crosses ~15% into
       * the viewport. Each element is unobserved after firing so the
       * work is bounded by the number of decorated elements.
       */
      const targets = document.querySelectorAll<HTMLElement>(
        "[data-reveal], [data-reveal-stagger]",
      );
      if (targets.length > 0 && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -15% 0px", threshold: 0.12 },
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add("is-revealed"));
      }
    </script>

    <script>
      /**
       * Premium pointer micro-interactions, added as a progressive
       * enhancement on top of the static layout:
       *   - [data-magnetic]  CTAs ease toward the cursor within their box
       *     (the press feels physical without a library).
       *   - [data-spotlight] surfaces track the cursor with a sapphire
       *     glow fed through --spot-x / --spot-y (the CSS draws it).
       *
       * Both are gated on a fine hover pointer and prefers-reduced-motion,
       * so touch and reduced-motion users get the clean static surface.
       */
      const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (fine && !reduce) {
        document.querySelectorAll<HTMLElement>("[data-spotlight]").forEach((el) => {
          el.addEventListener("pointermove", (event) => {
            const rect = el.getBoundingClientRect();
            el.style.setProperty("--spot-x", `${event.clientX - rect.left}px`);
            el.style.setProperty("--spot-y", `${event.clientY - rect.top}px`);
          });
        });

        document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((el) => {
          const STRENGTH = 0.28;
          const MAX = 6;
          let raf = 0;
          el.addEventListener("pointermove", (event) => {
            const rect = el.getBoundingClientRect();
            const dx = event.clientX - (rect.left + rect.width / 2);
            const dy = event.clientY - (rect.top + rect.height / 2);
            cancelAnimationFrame(raf);
            raf = requestAnimationFrame(() => {
              const x = Math.max(-MAX, Math.min(MAX, dx * STRENGTH));
              const y = Math.max(-MAX, Math.min(MAX, dy * STRENGTH));
              el.style.transform = `translate(${x}px, ${y}px)`;
            });
          });
          el.addEventListener("pointerleave", () => {
            cancelAnimationFrame(raf);
            el.style.transform = "";
          });
        });
      }
    </script>
  </body>
</html>
